; Hyperscale: Datacenter Tycoon — Godot 4.5.1
config_version=5

[application]
config/name="Hyperscale: Datacenter Tycoon"
config/version="1.2.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/use_custom_user_dir=true
; Preserve the original save location across the game rename.
config/custom_user_dir_name="Datacenter Tycoons"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/size/min_width=1152
window/size/min_height=720
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.055, 0.094, 0.11, 1)
